# The tests read the plugin files and the fixtures, so the sdist carries them.
include README.md LICENSE
include .claude-plugin/plugin.json .claude-plugin/marketplace.json
include hooks/hooks.json
include skills/action-vitals/SKILL.md
include .github/workflows/test.yml .github/workflows/release.yml
recursive-include tests *.py *.json *.txt *.yml *.yaml
global-exclude *.py[cod]
